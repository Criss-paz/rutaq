{
  "name": "rutaq",
  "private": true,
  "version": "0.1.0",
  "description": "RutaQ — Ruta más corta en la red vial del departamento de Quetzaltenango (Dijkstra / Floyd-Warshall)",
  "type": "module",
  "author": "Cristopher Alexis Castellanos Paz",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium webkit",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build",
    "anexo-codigo": "node tools/anexo-codigo.mjs",
    "capturas": "playwright test tests/e2e/capturas.spec.ts --project=desktop-chrome --project=pixel-7 --workers=1"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.19",
    "@xyflow/react": "^12.12.0",
    "comlink": "^4.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
